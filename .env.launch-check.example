# launch:check dry-run profile
#
# This file intentionally contains non-secret placeholder values only.
# It is for validating scripts/prelaunch-check.mjs control flow during local
# daily QA. It does not prove production credentials, provider contracts, or
# runtime secret injection.

LAUNCH_CHECK_MODE=dry-run

NEXT_PUBLIC_APP_URL=https://launch-check.example.invalid
NEXT_PUBLIC_BASE_URL=https://launch-check.example.invalid
DATABASE_URL=postgresql://launch_check:launch_check@localhost:5432/ipjuhae_launch_check
DB_SCHEMA=ipjuhae

JWT_SECRET=not-a-real-jwt-secret-for-launch-check-dry-run-only
DISCLOSURE_SIGNING_KEY=not-a-real-disclosure-key-for-launch-check-dry-run-only
CRON_SECRET=not-a-real-cron-secret-for-launch-check-dry-run-only

SMS_PROVIDER=nhn
NHN_SMS_APP_KEY=not-a-real-nhn-app-key
NHN_SMS_SECRET_KEY=not-a-real-nhn-secret-key
NHN_SMS_SENDER=01000000000

EMAIL_PROVIDER=resend
RESEND_API_KEY=not-a-real-resend-api-key

STORAGE_PROVIDER=s3
S3_BUCKET=not-a-real-launch-check-bucket
S3_ACCESS_KEY_ID=not-a-real-s3-access-key-id
S3_SECRET_ACCESS_KEY=not-a-real-s3-secret-access-key

VERIFICATION_PROVIDER=nice
NICE_CLIENT_ID=not-a-real-nice-client-id
NICE_CLIENT_SECRET=not-a-real-nice-client-secret
